# Orphan Radar environment variables. Copy to .env and fill in what you have.
# Everything is optional: without any key the tool still collects, detects,
# clusters (rule-based) and scores, and writes evidence-only briefs.

# Language-model provider for cluster labelling and brief prose: "anthropic", "openai" or "none".
ORPHAN_RADAR_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, a local Ollama/vLLM server, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name for the chosen provider. Defaults: claude-sonnet-5-5 / gpt-4.1-mini
ORPHAN_RADAR_LLM_MODEL=

# Raises GitHub's limit from 60 to 5,000 requests/hour. A token with no scopes is enough.
GITHUB_TOKEN=
# Optional Stack Exchange app key: raises the daily quota from 300 to 10,000.
STACKEXCHANGE_KEY=
# Optional Reddit "script" app credentials. The Reddit adapter stays off without them.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Where the SQLite database and caches live (default: ./data)
ORPHAN_RADAR_DATA_DIR=
# Alternative config file (default: ./config.toml)
ORPHAN_RADAR_CONFIG=
