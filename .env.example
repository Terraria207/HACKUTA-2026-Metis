# Fixture mode uses durable local SQLite, zero network model calls.
METIS_MODE=fixture
METIS_SQLITE_PATH=.metis/fixture.sqlite
METIS_API_TOKEN=
# Live mode requires MongoDB; it NEVER falls back to fixture data.
MONGODB_URI=
MONGODB_DATABASE=metis
METIS_ALLOW_LIVE=false
METIS_LIVE_BUDGET_USD=0
METIS_PROVIDERS_FILE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Opt-in only; immutable image digest and pinned project required.
METIS_LEAN_IMAGE=
METIS_LEAN_PROJECT=
