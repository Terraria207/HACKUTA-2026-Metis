# Most of this can be set in the app (Settings › Mode, API keys, Models); a value set here wins
# over the saved one and the screen says so. Fixture mode uses local SQLite and makes no model call.
METIS_MODE=fixture
# Settings saved from the app (mode, spending cap, database name); private 0600 file.
METIS_SETTINGS_FILE=.metis/server.json
METIS_SQLITE_PATH=.metis/fixture.sqlite
METIS_API_TOKEN=
# Live mode requires MongoDB; it NEVER falls back to fixture data.
MONGODB_URI=
MONGODB_DATABASE=metis
METIS_ALLOW_LIVE=false
METIS_LIVE_BUDGET_USD=0
# Role configuration and API keys saved from the Settings screen: private server files (0600).
# Both default to the git-ignored .metis/ directory. An environment variable below always wins
# over a key stored from the Settings screen.
METIS_PROVIDERS_FILE=.metis/providers.json
METIS_KEYS_FILE=.metis/keys.json
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
VOYAGE_API_KEY=
# Where basis groups come from: the export index directory written by scripts/index_export.py
# (every MSC field that holds mathlib declarations becomes a basis group, built on demand), or a
# single export file for one hand-written island spec. Empty: only the saved modules are offered.
METIS_MATHLIB_EXPORT=
# Fixture mode imports the reviewed bundles in corpus/ at startup; false leaves only fixtures.
METIS_IMPORT_CORPUS=true
# Opt-in Atlas Automated Embedding index mode (Preview feature).
METIS_ATLAS_AUTO_EMBED=false
# Opt-in only; immutable image digest and pinned project required.
METIS_LEAN_IMAGE=
METIS_LEAN_PROJECT=
